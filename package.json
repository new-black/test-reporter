{
  "name": "test-reporter",
  "version": "4.0.2",
  "private": true,
  "description": "Presents .NET test results (TRX) as a GitHub check run",
  "scripts": {
    "build": "tsc --noEmit",
    "format": "prettier --write **/*.ts",
    "format-check": "prettier --check **/*.ts",
    "lint": "eslint src/**/*.ts",
    "package": "esbuild src/main.ts --bundle --platform=node --target=node24 --outfile=dist/index.js --format=cjs",
    "version": "npm run build && npm run package && git add dist/*",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --ci",
    "jest:updatesnapshot": "node --experimental-vm-modules node_modules/jest/bin/jest.js --updateSnapshot",
    "all": "npm run build && npm run format && npm run lint && npm run package && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/new-black/test-reporter.git"
  },
  "keywords": [
    "actions",
    "node",
    "test",
    "report"
  ],
  "author": "Michal Dorner <dorner.michal@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@slack/webhook": "^8.0.2",
    "adm-zip": "^0.6.1",
    "fast-glob": "^3.3.3",
    "fast-xml-parser": "^5.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "overrides": {
    "minimatch": "11.0.1",
    "@isaacs/nonrecursive-glob-match": "1.0.1"
  }
}
