{
  "name": "test-check",
  "version": "2.1.0",
  "private": true,
  "description": "Presents test results from popular testing frameworks as Github check run",
  "main": "lib/main.js",
  "scripts": {
    "build": "tsc",
    "format": "prettier --write **/*.ts",
    "format-check": "prettier --check **/*.ts",
    "lint": "eslint src/**/*.ts",
    "package": "esbuild src/main.ts --bundle --platform=node --target=node20 --outfile=dist/index.js --format=cjs && eolConverter lf dist/*",
    "version": "npm run build && npm run package && git add dist/*",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --ci --reporters=default --reporters=jest-junit",
    "jest:updatesnapshot": "node --experimental-vm-modules node_modules/jest/bin/jest.js --updateSnapshot",
    "all": "npm run build && npm run format && npm run lint && npm run package && npm test",
    "dotnet-fixture": "dotnet test reports/dotnet/DotnetTests.XUnitTests --logger \"trx;LogFileName=../../../../__tests__/fixtures/dotnet-trx.trx\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dorny/test-check.git"
  },
  "keywords": [
    "actions",
    "node",
    "test",
    "report"
  ],
  "author": "Michal Dorner <dorner.michal@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/github": "^9.0.0",
    "@slack/webhook": "^7.0.6",
    "adm-zip": "^0.5.16",
    "fast-glob": "^3.3.3",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.1.0",
    "@types/xml2js": "^0.4.14",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eol-converter-cli": "^1.1.0",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-github": "^6.0.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.12.1",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "^30.2.0",
    "jest-junit": "^16.0.0",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  },
  "jest-junit": {
    "suiteName": "jest tests",
    "outputDirectory": "__tests__/__results__",
    "outputName": "jest-junit.xml",
    "ancestorSeparator": " › ",
    "uniqueOutputName": "false",
    "suiteNameTemplate": "{filepath}",
    "classNameTemplate": "{classname}",
    "titleTemplate": "{title}"
  }
}
